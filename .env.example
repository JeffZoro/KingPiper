# Copy to .env and fill in. These are read by the server routes in src/app/api
# only; they are never bundled into the app.

# Translation (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Speech-to-text and voices (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# Optional overrides
# PIPER_TRANSLATION_MODEL=claude-opus-5-5
# ELEVENLABS_VOICE_FEMALE=cgSgspJ2msm6clMCkdW9   # Jessica
# ELEVENLABS_VOICE_MALE=cjVigY5qzO86Huf0OWal     # Eric
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# For production native builds: where the deployed server lives.
# EXPO_PUBLIC_API_URL=https://your-piper.expo.app
